# Dependencies
node_modules/

# Build & render output (videos imported into src/ or public/ stay tracked)
dist/
build/
out/
*.mp4
*.mov
*.webm
!public/**/*.mp4
!public/**/*.webm

# Generated audio — rebuild with `npm run voice -- <name>` and `npm run score -- <name>`
public/voiceover/
public/music/

# Local TTS models — download with `npm run tts:setup`
.tts-models/

# Environment & secrets
.env
.env.*
!.env.example

# Logs & caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
.eslintcache
*.tsbuildinfo
.remotion/

# Editors & OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local Claude / agent state
.claude/settings.local.json
.memory-team
